{
  "name": "niels",
  "version": "1.0.0",
  "description": "Site officiel de Niels — auteur, compositeur, interprète.",
  "author": "Niels <contact@niels-officiel.fr>",
  "license": "ISC",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "concurrently -n css,web -c cyan,magenta \"npm run dev:css\" \"npm run dev:serve\"",
    "dev:css": "tailwindcss -i ./tailwind.css -o ./dist/tailwind.css --watch",
    "dev:serve": "http-server . -p 3000 -c-1",
    "fetch:salon": "node scripts/fetch-salon-videos.mjs",
    "generate:admin-auth": "node scripts/generate-admin-auth.mjs",
    "build": "tailwindcss -i ./tailwind.css -o ./dist/tailwind.css --minify"
  },
  "keywords": [
    "niels",
    "music",
    "artist"
  ],
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "http-server": "^14.1.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "otpauth": "^9.6.0"
  }
}
